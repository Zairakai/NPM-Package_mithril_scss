{
  "name": "@zairakai/mithril-scss",
  "version": "0.0.0",
  "description": "Modular SCSS framework with a mobile-first responsive grid, design tokens, functions, mixins, placeholders and light and dark themes",
  "keywords": [
    "mithril",
    "scss",
    "sass",
    "css",
    "framework",
    "grid",
    "responsive",
    "mobile-first",
    "spacing",
    "typography",
    "breakpoints",
    "design-tokens",
    "css-variables",
    "mixins",
    "theming",
    "dark-mode",
    "reset"
  ],
  "homepage": "https://mithril-scss-29f2e5.gitlab.io",
  "bugs": {
    "url": "https://gitlab.com/zairakai/npm-packages/mithril-scss/-/issues",
    "email": "contact-project+zairakai-npm-packages-mithril-scss-80191208-issue-@incoming.gitlab.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/zairakai/npm-packages/mithril-scss.git"
  },
  "funding": [
    {
      "type": "patreon",
      "url": "https://www.patreon.com/c/zairakai"
    },
    {
      "type": "twitch",
      "url": "https://www.twitch.tv/zairakai"
    }
  ],
  "license": "MIT",
  "author": "Stanislas Poisson <stanislas.p@the-white-rabbits.fr> (https://the-white-rabbits.fr)",
  "contributors": [
    {
      "name": "Stanislas Poisson",
      "url": "https://gitlab.com/zairakai",
      "role": "Maintainer"
    }
  ],
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./src/index.scss",
    "./bases/*.scss": "./src/bases/*.scss",
    "./animations": "./src/animations.scss",
    "./components": "./src/components/index.scss",
    "./src/*.scss": "./src/*.scss",
    "./src/*": "./src/*.scss"
  },
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "eslint": "bash node_modules/@zairakai/js-dev-tools/scripts/eslint.sh",
    "eslint:fix": "bash node_modules/@zairakai/js-dev-tools/scripts/eslint-fix.sh",
    "postinstall": "bash node_modules/@zairakai/js-dev-tools/scripts/setup-project.sh --silent || true",
    "markdownlint": "bash node_modules/@zairakai/js-dev-tools/scripts/markdownlint.sh",
    "markdownlint:fix": "bash node_modules/@zairakai/js-dev-tools/scripts/markdownlint-fix.sh",
    "normalize": "make package-normalize",
    "package:validate": "make package-validate",
    "prettier": "bash node_modules/@zairakai/js-dev-tools/scripts/prettier.sh",
    "prettier:fix": "bash node_modules/@zairakai/js-dev-tools/scripts/prettier-fix.sh",
    "setup": "bash node_modules/@zairakai/js-dev-tools/scripts/setup-project.sh",
    "stylelint": "bash node_modules/@zairakai/js-dev-tools/scripts/stylelint.sh",
    "stylelint:fix": "bash node_modules/@zairakai/js-dev-tools/scripts/stylelint-fix.sh",
    "test": "make test-all",
    "validate": "make quality"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "colord": "2.9.7",
    "fast-uri": "3.1.9",
    "js-yaml": {
      ".": "4.3.2"
    },
    "katex": "0.18.11",
    "markdown-it": "14.3.3",
    "minimatch": "11.0.6",
    "nanoid": "3.3.20",
    "re2js": "2.9.1",
    "smol-toml": "1.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "@zairakai/js-dev-tools": "^4.1.0",
    "knip": "^6.45.1",
    "sass": "^1.108.2",
    "sort-package-json": "^4.1.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
